# PostgreSQL connection string (Azure or Supabase direct)
# Azure:    postgresql://adminuser%40pg-processautomations-preprod:Password@pg-processautomations-preprod.postgres.database.azure.com:5432/gpg_claims?sslmode=require
# Supabase: postgresql://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

JWT_SECRET=change-this-to-a-long-random-secret

# Email (optional — notifications are skipped when not set)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

PORT=5001
